{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_MMG_CHANNEL": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "dev-sim": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_MMG_CHANNEL": "development"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_MMG_CHANNEL": "preview"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview-test": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_MMG_TEST_TOOLS": "1",
        "EXPO_PUBLIC_MMG_CHANNEL": "preview-test"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_MMG_CHANNEL": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6793652247"
      }
    }
  }
}
